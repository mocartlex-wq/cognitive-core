[Unit]
Description=Cognitive Core isolated durable workspace snapshot worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cogcore-coordination
Group=cogcore-coordination
WorkingDirectory=/opt/cognitive-core
EnvironmentFile=/etc/cogcore-coordination/worker.env
ExecStart=/opt/cognitive-core/.venv-coordination/bin/python -m tools.coordination_worker start
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cogcore-coordination/artifacts
# Configure readable allowlisted worktrees in worker.env; no repository writes.

[Install]
WantedBy=multi-user.target
